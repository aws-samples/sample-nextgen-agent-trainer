{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["businessName", "scenarios"],
  "properties": {
    "businessName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z]*$",
      "description": "Business vertical name (camelCase)"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scenarioId",
          "personaName",
          "scenarioName",
          "voiceId",
          "demographics",
          "behavior",
          "customerObjectives",
          "agentObjectives",
          "prompt"
        ],
        "properties": {
          "scenarioId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique identifier (kebab-case)"
          },
          "personaName": {
            "type": "string",
            "minLength": 1,
            "description": "Full name of the persona"
          },
          "scenarioName": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the scenario"
          },
          "voiceId": {
            "type": "string",
            "enum": ["matthew", "tiffany", "amy", "olivia", "arjun", "kiara"],
            "description": "Voice ID for text-to-speech"
          },
          "demographics": {
            "type": "object",
            "required": ["age", "gender", "location"],
            "properties": {
              "age": {
                "type": "integer",
                "minimum": 18,
                "maximum": 100
              },
              "gender": {
                "type": "string",
                "enum": ["Male", "Female", "Non-binary", "Other"]
              },
              "location": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "behavior": {
            "type": "object",
            "required": ["communicationStyle", "emotionalState"],
            "properties": {
              "communicationStyle": {
                "type": "string",
                "minLength": 10
              },
              "emotionalState": {
                "type": "string",
                "minLength": 10
              }
            }
          },
          "customerObjectives": {
            "type": "object",
            "required": ["primary"],
            "properties": {
              "primary": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 5
                },
                "minItems": 1
              },
              "secondary": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          },
          "agentObjectives": {
            "type": "object",
            "required": ["primary"],
            "properties": {
              "primary": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 5
                },
                "minItems": 1
              },
              "secondary": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              }
            },
            "description": "Objectives for the call center agent"
          },
          "prompt": {
            "type": "string",
            "minLength": 50,
            "description": "Full system prompt for the persona"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes about the customer or scenario"
          },
          "scenarioInteraction": {
            "type": "string",
            "description": "Expected scenario interaction or conversation flow"
          }
        }
      }
    }
  }
}
